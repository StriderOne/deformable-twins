FROM pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime@sha256:7b324d212a4450795b49edba9949b7cdc72429148a64e974334bfe5774d51385

USER root
RUN sed -i 's|http://|https://|g' /etc/apt/sources.list \
    && apt-get -o Acquire::ForceIPv4=true -o Acquire::Retries=3 update \
    && apt-get -o Acquire::ForceIPv4=true -o Acquire::Retries=3 install -y --no-install-recommends \
    git libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-phystwin-vi.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cu128 \
    -r /tmp/requirements.txt && python -m pip check
RUN mkdir -p /home/homa && chmod 755 /home/homa \
    && git config --system --add safe.directory /workspace \
    && git config --system --add safe.directory /workspace/third_party/PhysTwin
ENV HOME=/home/homa PYTHONPATH=/workspace/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility
WORKDIR /workspace
CMD ["bash"]
